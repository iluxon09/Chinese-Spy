# Supabase project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable key (safe to expose to the browser; never use the service-role/secret key here)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Gemini Developer API key from Google AI Studio (server-side only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional model override; defaults to gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional model for Google Search-grounded market intelligence; defaults to GEMINI_MODEL.
MARKET_INSIGHTS_MODEL=gemini-3.8-flash

# Secret shared by the protected market-data worker and the existing Supabase Vault.
# Generate locally; never commit the production value.
TILT_MARKET_REFRESH_SECRET=GENERATE_A_32_BYTE_RANDOM_SECRET
